<?xml version="1.0"?>
<ruleset name="Solo Skeleton">
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <file>bin/migrate</file>
    <file>bootstrap</file>
    <file>config</file>
    <file>database</file>
    <file>public</file>
    <file>src</file>
    <file>tests</file>

    <rule ref="PSR12"/>

    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
        </properties>
    </rule>
</ruleset>
